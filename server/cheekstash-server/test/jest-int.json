{
    "moduleFileExtensions": ["js", "json", "ts"],
    "rootDir": "integration", 
    "testEnvironment": "node",
    "testRegex": ".spec.ts$",  
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "moduleNameMapper": { 
       "^src/(.*)$": "<rootDir>/../../src/$1" 
    },
    "testTimeout": 30000
  }